{
  "name": "copymachine-root",
  "private": true,
  "workspaces": [
    "packages/frontend",
    "packages/backend",
    "packages/shared"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm --prefix packages/frontend run dev",
    "dev:backend": "npm --prefix packages/backend run dev",
    "build": "npm --prefix packages/frontend run build",
    "preview": "npm --prefix packages/frontend run preview",
    "test": "npm --prefix packages/frontend run test",
    "format": "npm --prefix packages/frontend run format",
    "lint": "npm --prefix packages/frontend run lint",
    "check": "npm --prefix packages/frontend run check",
    "start": "npm run dev",
    "frontend:install": "npm --prefix packages/frontend install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
