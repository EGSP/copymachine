{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Full launch",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Backend (Debug)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/packages/backend/src/index.ts",
      "runtimeArgs": ["--import", "tsx"],
      "cwd": "${workspaceFolder}/packages/backend",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "Frontend (Debug)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--inspect",
        "${workspaceFolder}/node_modules/vite/bin/vite.js",
        "dev"
      ],
      "cwd": "${workspaceFolder}/packages/frontend",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "startDebugging",
        "name": "Chrome",
        "pattern": "Local:\\s+http://localhost:[0-9]+"
      },
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/packages/frontend/src"
    }
  ],
  "compounds": [
    {
      "name": "Full launch (Debug)",
      "configurations": ["Backend (Debug)", "Frontend (Debug)"],
      "stopAll": true,
      "presentation": {
        "group": "fullstack",
        "order": 1
      }
    }
  ]
}
