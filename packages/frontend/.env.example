# В репозитории уже есть закоммиченный .env с дефолтами; для секретов — .env.local (игнорируется git).
# Для production используй .env.production.
#
# URL бэкенда — в коде: import.meta.env.VITE_BACKEND_URL
VITE_BACKEND_URL=http://localhost:3001

# Порт Vite dev-сервера (читается только в vite.config.ts)
VITE_DEV_SERVER_PORT=3000
